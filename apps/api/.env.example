# Copy this file to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=3000

# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL="postgresql://errand:errand@localhost:5432/errandconnect?schema=public"

# Redis (real-time features, job queues - Phase 2)
REDIS_URL="redis://localhost:6379"

# Secrets: use long random values in production, e.g. `openssl rand -base64 48`
JWT_SECRET="change-me-jwt-secret"
OTP_SECRET="change-me-otp-secret"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Where uploaded documents are stored (local disk for development)
STORAGE_DIR="./uploads"

# First super admin, created by `npm run db:seed` if set
SEED_ADMIN_PHONE=""
SEED_ADMIN_PASSWORD=""
