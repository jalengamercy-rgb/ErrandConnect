# Copy this file to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=3000

# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL="postgresql://errand:errand@localhost:5432/errandconnect?schema=public"

# Redis (real-time features, job queues - Phase 2)
REDIS_URL="redis://localhost:6379"

# Secrets: use long random values in production, e.g. `openssl rand -base64 48`
JWT_SECRET="change-me-jwt-secret"
OTP_SECRET="change-me-otp-secret"
# Encrypts staff two-factor secrets in the database (falls back to JWT_SECRET in development)
DATA_ENCRYPTION_KEY=""
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Where uploaded documents are stored (local disk for development)
STORAGE_DIR="./uploads"

# First super admin, created by `npm run db:seed` if set
SEED_ADMIN_PHONE=""
SEED_ADMIN_PASSWORD=""

# Comma-separated browser origins allowed to call the API (required in production)
CORS_ORIGINS=""

# ─── M-Pesa ───
# fake = simulated (payments confirm after 3 s; no real money). daraja = Safaricom.
MPESA_MODE=fake
# Random secret placed in callback URLs: openssl rand -hex 24
MPESA_CALLBACK_SECRET="change-me-callback-secret"
# Daraja settings (https://developer.safaricom.co.ke), needed when MPESA_MODE=daraja
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
# Public HTTPS URL of this API that Safaricom can reach
MPESA_CALLBACK_BASE_URL=""
# B2C (withdrawals)
MPESA_B2C_SHORTCODE=""
MPESA_INITIATOR_NAME=""
MPESA_SECURITY_CREDENTIAL=""

# ─── Security & operations ───
# Staff must use two-factor sign-in for the admin panel (always true in production)
STAFF_MFA_REQUIRED=false
# Number of reverse proxies in front of the API (e.g. 1 behind Caddy/nginx/a load balancer)
TRUST_PROXY=
# Set to false to log only errors, not every request
LOG_REQUESTS=true

# ─── SMS (Africa's Talking) ───
# Required in production for sign-up/login codes. AT_USERNAME=sandbox uses their free sandbox.
AT_USERNAME=
AT_API_KEY=
# Registered sender ID (optional)
AT_SENDER_ID=
